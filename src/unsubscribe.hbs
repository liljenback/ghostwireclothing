        <div class="d-flex flex-wrap gap-3 mb-4">
          <a class="btn btn-outline-dark" href="/email-preferences.html#frequency">Reduce email frequency</a>
          <a class="btn btn-outline-dark" href="/email-preferences.html">Manage email preferences</a>
