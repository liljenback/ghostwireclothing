<noscript><p class="alert alert-warning">Please enable JavaScript to use the consultation form.</p></noscript>
<form class="contact-form" data-consultation-form action="/api/fashion-consultation" method="post" aria-describedby="consultation-note">
  <div class="alert alert-danger" id="consultation-error-summary" role="alert" tabindex="-1" hidden></div>
  <div class="alert alert-success" id="consultation-result" role="status" tabindex="-1" hidden></div>
  <fieldset data-consultation-controls disabled>
    <legend class="visually-hidden">Request a free 20-minute consultation</legend>
    <div class="mb-4">
      <label class="form-label" for="consultation-timezone">Timezone *</label>
      <select class="form-select" id="consultation-timezone" name="timezone" aria-describedby="consultation-timezone-note consultation-timezone-error" required>
        <option value="UTC">UTC</option>
      </select>
      <p class="text-muted mt-2" id="consultation-timezone-note">Choose the timezone for your call.</p>
      <p class="contact-field-error" id="consultation-timezone-error" data-error-for="timezone" hidden></p>
    </div>
    <div class="row">
      <div class="col-md-6 mb-4">
        <label class="form-label" for="consultation-date">Preferred date *</label>
        <input class="form-control" id="consultation-date" type="date" name="date" aria-describedby="consultation-date-error" required>
        <p class="contact-field-error" id="consultation-date-error" data-error-for="date" hidden></p>
      </div>
      <div class="col-md-6 mb-4">
        <label class="form-label" for="consultation-time">Preferred time *</label>
        <select class="form-select" id="consultation-time" name="time" aria-describedby="consultation-time-error" required>
          <option value="">Select a 20-minute time slot</option>
        </select>
        <p class="contact-field-error" id="consultation-time-error" data-error-for="time" hidden></p>
      </div>
    </div>
    <div class="mb-4">
      <label class="form-label" for="consultation-name">Full name *</label>
      <input class="form-control" id="consultation-name" name="name" autocomplete="name" maxlength="200" aria-describedby="consultation-name-error" required>
      <p class="contact-field-error" id="consultation-name-error" data-error-for="name" hidden></p>
    </div>
    <div class="mb-4">
      <label class="form-label" for="consultation-email">Email address *</label>
      <input class="form-control" id="consultation-email" type="email" name="email" autocomplete="email" maxlength="254" aria-describedby="consultation-email-error" required>
      <p class="contact-field-error" id="consultation-email-error" data-error-for="email" hidden></p>
    </div>
    <div class="mb-4">
      <label class="form-label" for="consultation-reason">What would you like help with? *</label>
      <textarea class="form-control" id="consultation-reason" name="reason" rows="4" maxlength="2000" aria-describedby="consultation-reason-error" required></textarea>
      <p class="contact-field-error" id="consultation-reason-error" data-error-for="reason" hidden></p>
    </div>
    <p class="text-muted">Fields marked with * are required.</p>
    <button class="btn contact-submit" type="submit">Request consultation</button>
  </fieldset>
</form>
<script src="/js/fashion-consultation.js" defer></script>
