<!-- header section starts -->
<a class="visually-hidden-focusable" href="#main-content">Skip to main content</a>
<div id="settingsForm" class="container p-3 my-3 border border-3" style="display:none; position:relative;">
  <script>
    document.addEventListener('keydown', function (event) {
      if (event.key === "Escape") {
        document.getElementById('settingsForm').style.display = 'none';
      }
    });
  </script>
  <script>
    document.addEventListener('keydown', function (event) {
      if (event.ctrlKey && event.key === "b") {
        if (document.getElementById('settingsForm').style.display === 'none') {
          document.getElementById('settingsForm').style.display = 'block';
        } else {
          document.getElementById('settingsForm').style.display = 'none';
        }
      }
    });
  </script>

  <button title="Close Settings"
    style="justify-content: center; align-items:center; color: #AAA; font-weight: bold; border-width: 1px; border-style: solid; border-color: #AAA; border-radius: 50%; margin: 10px; position: absolute; top: 10px; right: 10px;"
    type="button" aria-label="Close"
    onclick="document.getElementById('settingsForm').style.display = 'none';">X</button>

  <ul class="nav nav-tabs" id="settingsTab" role="tablist">
    <li class="nav-item">
      <a class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab"
        aria-controls="general" aria-selected="true">General</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" id="advanced-tab" data-bs-toggle="tab" data-bs-target="#advanced" type="button" role="tab"
        aria-controls="advanced" aria-selected="false">Advanced</a>
    </li>
  </ul>
  <div class="tab-content p-3" id="settingsTabContent">
    <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab" tabindex="0">
      <p>General settings go here.</p>
    </div>
    <div class="tab-pane fade" id="advanced" role="tabpanel" aria-labelledby="advanced-tab" tabindex="0">
      <p>Advanced settings go here.</p>
    </div>
  </div>
</div>
