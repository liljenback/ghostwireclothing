  <script>
    // Consent management
    function getCookie(name) {
      var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      return match ? match[2] : null;
    }

    function setCookie(name, value, days) {
      var expires = '';
      if (days) {
        var date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        expires = '; expires=' + date.toUTCString();
      }
      var domain = window.location.hostname.split('.').slice(-2).join('.');
      document.cookie = name + '=' + value + expires + '; path=/; domain=' + domain + '; SameSite=Lax';
    }

    function setConsent(optOut) {
      if (typeof alloy === 'undefined') {
        console.warn('alloy is not defined');
        return;
      }
      var consentVal = optOut ? 'n' : 'y';
      alloy("setConsent", {
        consent: [{
          standard: "Adobe",
          version: "2.0",
          value: {
            collect: { val: consentVal },
            metadata: { time: new Date().toISOString() }
          }
        }]
      });
      console.log('Consent set to ' + consentVal);
    }

    function waitForAlloyThen(callback) {
      if (typeof alloy !== 'undefined') {
        callback();
      } else {
        setTimeout(function () { waitForAlloyThen(callback); }, 200);
      }
    }

    // URL parameter override
    (function () {
      function getUrlParameter(name) {
        name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
        var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
        var results = regex.exec(location.search);
        return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
      }
      var optOutParam = getUrlParameter('opt-out');
      if (optOutParam !== '') {
        setCookie('ConsentStatus', optOutParam === 'true' ? 'out' : 'in', 365);
      }
    })();

    function ensureConsentModal() {
      if (document.getElementById('consentModal')) return;
      var modalHtml =
        '<div class="modal fade" id="consentModal" tabindex="-1" role="dialog" aria-labelledby="consentModalLabel" aria-hidden="true">' +
          '<div class="modal-dialog modal-dialog-centered" role="document">' +
            '<div class="modal-content">' +
              '<div class="modal-header">' +
                '<h5 class="modal-title" id="consentModalLabel">Cookie Consent</h5>' +
              '</div>' +
              '<div class="modal-body">' +
                '<p>Help make our product better for you and all users! We collect analytics telemetry\u2014including usage patterns, performance metrics, and diagnostic data\u2014to identify issues, improve features, and enhance your experience.</p>' +
                '<p>Do you consent to the collection of analytics telemetry? You can change your preference anytime via the cookie settings link at the bottom of the page. <a href="/privacy_policy.html" target="_blank">Privacy Policy</a></p>' +
              '</div>' +
              '<div class="modal-footer">' +
                '<button type="button" class="btn btn-outline-secondary" id="consentNoBtn">No</button>' +
                '<button type="button" class="btn btn-primary" id="consentYesBtn">Yes</button>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>';
      document.body.insertAdjacentHTML('beforeend', modalHtml);

      function handleConsent(consented) {
        setCookie('ConsentStatus', consented ? 'in' : 'out', 365);
        document.body.classList.remove('consent-modal-open');
        $('#consentModal').modal('hide');
        waitForAlloyThen(function () {
          setConsent(!consented);
        });
      }

      document.getElementById('consentYesBtn').addEventListener('click', function () {
        handleConsent(true);
      });

      document.getElementById('consentNoBtn').addEventListener('click', function () {
        handleConsent(false);
      });
    }

    function openConsentModal() {
      ensureConsentModal();
      document.body.classList.add('consent-modal-open');
      $('#consentModal').modal({ backdrop: true, keyboard: true });
      $('#consentModal').on('hidden.bs.modal', function () {
        document.body.classList.remove('consent-modal-open');
        if (!getCookie('ConsentStatus')) {
          setCookie('ConsentStatus', 'out', 365);
          waitForAlloyThen(function () { setConsent(true); });
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      var consentCookie = getCookie('ConsentStatus');

      if (consentCookie) {
        waitForAlloyThen(function () {
          setConsent(consentCookie === 'out');
        });
        return;
      }

      openConsentModal();
    });
  </script>
