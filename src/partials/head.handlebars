  <script>
    // Consent management script
    function getUrlParameter(name) {
      name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
      var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
      var results = regex.exec(location.search);
      return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
    }

    var optOutParam = getUrlParameter('opt-out');
    if (optOutParam !== '') {
      localStorage.setItem('optOut', optOutParam === 'true');
    }

    var optOut = localStorage.getItem('optOut') === 'true';

    function setConsent(value) {
      if (typeof alloy === 'undefined') {
        console.warn('alloy is not defined');
        return;
      }
      var consentVal = value ? 'n' : 'y';
      alloy("setConsent", {
        consent: [{
          standard: "Adobe",
          version: "2.0",
          value: {
            collect: {
              val: consentVal
            },
            metadata: {
              time: new Date().toISOString()
            }
          }
        }]
      });
      console.log('Consent set to ' + consentVal);
    }

    function waitForAlloy() {
      if (typeof alloy !== 'undefined') {
        setConsent(optOut);
      } else {
        setTimeout(waitForAlloy, 200);
      }
    }
    waitForAlloy();
  </script>
