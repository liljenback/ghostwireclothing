  <script>
    const getServerTimingDescription = (name) => { const nav = performance.getEntriesByType('navigation')[0]; if (!nav?.serverTiming) return null; const entry = nav.serverTiming.find(st => st.name === name); return entry?.description || null; };
    const getMetaContentValue = (name) => { const meta = document.querySelector(`meta[name="${name}"]`); return meta ? meta.getAttribute('content') : null; }; 
    const hasExistingIdentity = (orgId) => {
      const prefix = `kndctr_${orgId}_AdobeOrg_identity=`;
      return document.cookie
        .split(';')
        .map(c => c.trim())
        .some(c => c.startsWith(prefix));
    };
  </script>
