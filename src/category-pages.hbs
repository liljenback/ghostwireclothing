---
pagination:
  data: categories
  size: 1
  alias: cat
permalink: false
pageName: category
---
<!DOCTYPE html>
<html lang="en">
{{> head}}

<body class="sub_page">
  <div class="hero_area">
    {{> nav active='products'}}
  </div>
  <!-- inner page section -->
  <section class="inner_page_head">
    <div class="container_fuild">
      <div class="row">
        <div class="col-md-12">
          <div class="full">
            <h1>Our Products</h1>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- end inner page section -->
  <!-- product section -->
  {{> product_cards products=cat.products title=cat.name details=true addToCart=true}}
  <!-- end product section -->
  {{> footer}}
</body>

</html>
