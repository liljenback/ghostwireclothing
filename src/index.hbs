---
permalink: index.html
pageName: index
---
<!DOCTYPE html>
<html lang="en">

{{> head}}

<body>
  <div class="hero_area">
    {{> nav active='home'}}
    <!-- slider section -->
    <section class="slider_section ">
      <div class="slider_bg_box">
        <img src="images/slider-bg.jpg" loading="lazy" alt="Sale promotion banner">
      </div>
      <div id="customCarousel1" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
          <div class="carousel-item active">
            <div class="container ">
              <div class="row">
                <div class="col-md-7 col-lg-6 ">
                  <div class="detail-box">
                    <h1>
                      <span>
                        Sale 20% Off
                      </span>
                      <br>
                      On Everything
                    </h1>
                    <div class="btn-box">
                      <a href="/categories/all.html" class="btn1">
                        Shop Now
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- end slider section -->
  </div>

  <main id="main-content">
  <!-- product section -->
  <section class="product_section layout_padding">
    <div class="container">
      <div class="heading_container heading_center">
        <h2>
          Our products
        </h2>
      </div>

      {{> product_cards products=featuredProducts details=false addToCart=true}}

      <div class="btn-box">
        <a href="/categories/all.html">
          View All products
        </a>
      </div>
    </div>
  </section>
  <!-- end product section -->

  <section class="shopping-support" aria-label="Style help and newsletter">
    <div class="container">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="shopping-support-card">
            <h2>Need style advice?</h2>
            <p>Talk to a Ghostwire Fashion Expert. Free, 20-minute calls.</p>
            <a class="btn newsletter-link" href="/fashion-consultation.html">Schedule a Free Call</a>
          </div>
        </div>
        <div class="col-md-6">
          <div class="shopping-support-card">
            <h2>Stay in the loop</h2>
            <p>New collections and offers, on your schedule.</p>
            <a class="btn newsletter-link" href="/newsletter.html">Subscribe</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {{> testimonial_cards}}
  </main>

  {{> footer}}
</body>

</html>
